# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# Every REQUIRED variable must be set or the app will not run.
# Verify a deployment with GET /api/health — it lists anything missing.
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string.
# Neon: https://neon.tech (free) · Supabase · Vercel Postgres · Railway
# Neon/Supabase poolers need ?sslmode=require appended.
DATABASE_URL="postgresql://user:password@host:5432/coursegen?sslmode=require"

# REQUIRED — random secret used to sign NextAuth session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# REQUIRED in production — the public origin of this deployment, no trailing slash.
# Local: http://localhost:3000 · Prod: https://your-app.vercel.app
# On Vercel this can be omitted; VERCEL_URL is used as a fallback.
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED — Google OAuth credentials.
# https://console.cloud.google.com/apis/credentials -> Create OAuth client ID -> Web application
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# REQUIRED — OpenAI, used to generate the syllabus and chapter summaries.
# https://platform.openai.com/api-keys  (needs billing credit, not just a free trial)
OPENAI_API_KEY=""

# Optional — overrides the model. Defaults to gpt-4o-mini (cheap and fast).
# OPENAI_MODEL="gpt-4o-mini"

# REQUIRED — YouTube Data API v3 key, used to find a video per chapter.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# NOTE: each chapter costs 100 quota units; the default daily quota is 10,000,
# which is roughly 100 chapters per day.
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# Optional — the app runs without these, with the related feature disabled.
# ---------------------------------------------------------------------------

# Course cover images. Without it, courses use a bundled placeholder image.
# https://unsplash.com/oauth/applications  (use the "Access Key")
UNSPLASH_API_KEY=""

# Stripe subscriptions. Without BOTH of these, the Pro upgrade UI is hidden
# and /api/stripe returns 503.
# Secret key:     https://dashboard.stripe.com/apikeys        (sk_test_... / sk_live_...)
# Webhook secret: https://dashboard.stripe.com/webhooks       (whsec_...)
#   Endpoint URL:  <NEXTAUTH_URL>/api/webhook
#   Events:        checkout.session.completed, invoice.payment_succeeded,
#                  customer.subscription.updated, customer.subscription.deleted
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
